# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environment
.env
.venv/
venv/

# Data (symlinked — never track actual datasets)
# Root-level data/ only (symlink to external dataset). src/data/ is source.
/data/
!data/.gitkeep

# Models (large checkpoints)
models/*.pt
models/*.pth
models/**/*.pt
models/**/*.pth

# Results artifacts (exclude raw outputs and large files)
results/**/*.h5
results/**/*.npy
results/**/*.npz
results/**/*.pkl

# Exclude CSVs by default BUT un-ignore Phase 0.4 required artifacts
results/**/*.csv
!results/phase_0/physics/parameter_registry.csv

# Logs
*.log
tensorboard/
runs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Required Phase 0 artifact — track despite results/**/*.csv rule
!results/phase_0/physics/parameter_registry.csv

# ---- Phase 0 physics artifacts (required for gate verification) ----
!results/phase_0/physics/parameter_registry.csv
!results/phase_0/physics/parameter_provenance.md
!results/phase_0/phase_0_manifest.json
